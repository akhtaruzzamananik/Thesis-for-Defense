# Normalize line endings across Windows/Linux teammates
* text=auto eol=lf

# Text and documentation
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.bib text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary files (safe documentation figures if ever added)
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
